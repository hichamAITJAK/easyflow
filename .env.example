APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_GOOGLE_MAPS_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_orders,read_products,read_customers
SHOPIFY_REVIEW_PASSWORD=EasyFlow_2026

YOUCAN_CLIENT_ID=
YOUCAN_CLIENT_SECRET=
YOUCAN_SCOPES=read-orders+edit-orders+delete-orders+read-categories+delete-categories+edit-categories+read-customers+edit-customers+delete-customers+read-products+edit-products+delete-products+read-rest-hooks+edit-rest-hooks+delete-rest-hooks+read-products-review+delete-products-review+edit-products-review+view-store-insights+view-store-tickets+view-store-profits+view-store-packs+view-store-info+edit-store-info
YOUCAN_REDIRECT_URI=

LIGHTFUNNELS_CLIENT_ID=
LIGHTFUNNELS_CLIENT_SECRET=
LIGHTFUNNELS_ACCOUNT_ID=
LIGHTFUNNELS_SCOPES=funnels,products,orders,analytics,customers

POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_DISABLED=false
VITE_POSTHOG_KEY="${POSTHOG_PROJECT_TOKEN}"
VITE_POSTHOG_HOST="${POSTHOG_HOST}"
VITE_POSTHOG_DISABLED="${POSTHOG_DISABLED}"

# SENDIT
SENDIT_BASE_URL=https://app.sendit.ma/api/v1
SENDIT_PUBLIC_KEY=
SENDIT_SECRET_KEY=

# OZONEXPRESS
OZON_EXPRESS_BASE_URL=https://api.ozonexpress.ma
OZON_EXPRESS_CLIENT_ID=
OZON_EXPRESS_CLIENT_SECRET=

# FORCELOG
# Developer key, used only to sync the courier-wide city list
# (php artisan couriers:sync-cities --courier=FORCELOG). Tenant shipments
# authenticate with each delivery account's own key instead.
FORCELOG_API_KEY=

# Platform owner, created by `php artisan db:seed`. Leave blank to skip.
# Re-seeding never resets an existing account's password.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
